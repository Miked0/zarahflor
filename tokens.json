{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Clínica de estética especialista em pele negra — editorial, inclusivo, premium.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.165,
          0.09,
          0.071
        ],
        "hex": "#2a1712"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.431,
          0.369,
          0.322
        ],
        "hex": "#6e5e52"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.788,
          0.58,
          0.29
        ],
        "hex": "#c9944a"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.969,
          0.949
        ],
        "hex": "#faf7f2"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "accent-hibisco": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.639,
          0.208,
          0.682
        ],
        "hex": "#a335ae"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.165,
          0.09,
          0.071
        ],
        "hex": "#2a1712"
      }
    },
    "on-hibisco": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0.35,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.14,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist",
        "fontSize": {
          "value": 0.62,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    },
    "stat-num": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 2.4,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    }
  }
}
